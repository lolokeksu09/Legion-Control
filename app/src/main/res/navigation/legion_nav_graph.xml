<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/legion_nav_graph"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="dev.lolokeksu.legioncontrol.HubPageFragment"
        android:label="Главная">
        <argument android:name="page" app:argType="string" android:defaultValue="home"/>
    </fragment>
    <fragment
        android:id="@+id/gamesFragment"
        android:name="dev.lolokeksu.legioncontrol.HubPageFragment"
        android:label="Игры">
        <argument android:name="page" app:argType="string" android:defaultValue="games"/>
    </fragment>
    <fragment
        android:id="@+id/toolsFragment"
        android:name="dev.lolokeksu.legioncontrol.HubPageFragment"
        android:label="Инструменты">
        <argument android:name="page" app:argType="string" android:defaultValue="tools"/>
    </fragment>
    <fragment
        android:id="@+id/historyFragment"
        android:name="dev.lolokeksu.legioncontrol.HubPageFragment"
        android:label="История">
        <argument android:name="page" app:argType="string" android:defaultValue="history"/>
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="dev.lolokeksu.legioncontrol.HubPageFragment"
        android:label="Настройки">
        <argument android:name="page" app:argType="string" android:defaultValue="settings"/>
    </fragment>
    <fragment
        android:id="@+id/gameDetailFragment"
        android:name="dev.lolokeksu.legioncontrol.GameDetailFragment"
        android:label="Игра">
        <argument android:name="gamePackage" app:argType="string"/>
    </fragment>
    <fragment
        android:id="@+id/gameSessionFragment"
        android:name="dev.lolokeksu.legioncontrol.GameSessionFragment"
        android:label="Game Session">
        <argument android:name="smart_package" app:argType="string" android:defaultValue=""/>
        <argument android:name="smart_label" app:argType="string" android:defaultValue=""/>
        <argument android:name="smart_tcp" app:argType="boolean" android:defaultValue="false"/>
    </fragment>
    <activity
        android:id="@+id/diagnosticsDestination"
        android:name="dev.lolokeksu.legioncontrol.MainActivity" />
    <activity
        android:id="@+id/gameToolboxDestination"
        android:name="dev.lolokeksu.legioncontrol.GameToolboxActivity" />
    <activity
        android:id="@+id/captureStudioDestination"
        android:name="dev.lolokeksu.legioncontrol.CaptureStudioActivity" />
    <fragment
        android:id="@+id/smartProfilesDestination"
        android:name="dev.lolokeksu.legioncontrol.SmartProfilesFragment"
        android:label="Smart Profiles">
        <argument android:name="app_center_package" app:argType="string" android:defaultValue=""/>
    </fragment>
    <fragment
        android:id="@+id/applicationCenterDestination"
        android:name="dev.lolokeksu.legioncontrol.ApplicationCenterFragment"
        android:label="Application Center">
        <argument android:name="app_center_package" app:argType="string" android:defaultValue=""/>
    </fragment>
    <fragment
        android:id="@+id/experimentLabDestination"
        android:name="dev.lolokeksu.legioncontrol.ExperimentLabFragment"
        android:label="Experiment Lab">
        <argument android:name="experiment_package" app:argType="string" android:defaultValue=""/>
    </fragment>
    <fragment
        android:id="@+id/connectivityLabDestination"
        android:name="dev.lolokeksu.legioncontrol.ConnectivityLabFragment"
        android:label="Connectivity Observatory" />
    <fragment
        android:id="@+id/audioLabDestination"
        android:name="dev.lolokeksu.legioncontrol.AudioLabFragment"
        android:label="Audio Lab" />
    <fragment
        android:id="@+id/hapticLabDestination"
        android:name="dev.lolokeksu.legioncontrol.HapticLabFragment"
        android:label="Haptic Lab" />
    <activity
        android:id="@+id/gamingDiagnosticsDestination"
        android:name="dev.lolokeksu.legioncontrol.GamingDiagnosticsActivity" />
    <activity
        android:id="@+id/hardwareLabDestination"
        android:name="dev.lolokeksu.legioncontrol.HardwareLabActivity" />
    <fragment
        android:id="@+id/compatibilityLabDestination"
        android:name="dev.lolokeksu.legioncontrol.CompatibilityLabFragment"
        android:label="Compatibility Lab" />
    <activity
        android:id="@+id/gamepadLiveDestination"
        android:name="dev.lolokeksu.legioncontrol.GamepadLiveActivity" />
    <activity
        android:id="@+id/displayPatternDestination"
        android:name="dev.lolokeksu.legioncontrol.DisplayPatternActivity" />
</navigation>
